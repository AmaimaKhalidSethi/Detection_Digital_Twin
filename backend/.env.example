# Copy these authentication settings into backend/.env. Keep existing Wazuh and AI settings intact.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-48-character-or-longer-random-secret
JWT_EXPIRATION_MINUTES=60
# Set true when the frontend is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Wazuh TLS is verified by default. Set a CA bundle for private lab PKI.
WAZUH_CA_BUNDLE=
# Lab-only emergency override; never enable this for an untrusted network.
WAZUH_INSECURE_SKIP_TLS_VERIFY=false