# ============================================================
# Detection Digital Twin — root .gitignore
# Covers: Python backend, React/Vite frontend, SQLite artifacts
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/

# ---------- SQLite databases ----------
# Application DB (backend/app/models/db.py defaults to sqlite:///./ddt.db)
*.db
*.db-journal
*.sqlite
*.sqlite3
# Ad-hoc test DBs some test files fall back to creating in the CWD
# (test_ddt.db, test_ddt_coverage.db) when DDT_TEST_DB isn't preset
test_*.db

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
!frontend/.env.example

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Editors / OS ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
backend/.env
# ---------- Logs ----------
logs/
*.log